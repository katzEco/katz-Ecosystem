# Timezone
TZ=Asia/Bangkok

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Todo Service
TODO_PORT=3000

# Bot Tokens & Whitelist (optional)
TELEGRAM_TOKEN=your_telegram_bot_token_here
DISCORD_TOKEN=your_discord_bot_token_here
TELEGRAM_ADMIN_ID=123456789
DISCORD_ADMIN_ID=987654321012345678

# Live Detector Service
DETECTOR_PORT=3030
N8N_DEFAULT_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/tiktok-live
CHECK_INTERVAL_SECONDS=60
INITIAL_USERNAMES=
API_KEY=
WEBHOOK_SECRET=

# Utils Service
UTILS_PORT=3050
UTILS_TELEGRAM_TOKEN=your_utils_telegram_bot_token_here
UTILS_DISCORD_TOKEN=your_utils_discord_bot_token_here
UTILS_TELEGRAM_ADMIN_ID=123456789
UTILS_DISCORD_ADMIN_ID=987654321012345678
